{
  "name": "@thulioph/deskercise",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thulioph/deskercise.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": false
  },
  "type": "module",
  "description": "Local-first workplace movement breaks for developers",
  "bin": {
    "deskercise": "dist/index.js"
  },
  "files": [
    "dist",
    "npm-shrinkwrap.json",
    "docs/npm-publishing.md",
    "docs/Chart.js-LICENSE.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/assets.mjs",
    "dev": "node --import tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "test:package": "node scripts/test-package.mjs",
    "check": "tsc --noEmit",
    "prepare": "node scripts/install-hooks.mjs",
    "lint:commits": "node scripts/lint-commits.mjs",
    "release": "node scripts/semantic-release.mjs",
    "release:dry-run": "node scripts/semantic-release.mjs --dry-run"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "better-sqlite3": "^12.0.0",
    "chart.js": "^4.5.0",
    "commander": "^14.0.0",
    "ink": "^6.0.0",
    "node-notifier": "^10.0.1",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/node-notifier": "^8.0.0",
    "@types/react": "^19.0.0",
    "conventional-changelog-conventionalcommits": "9.3.0",
    "husky": "9.1.7",
    "semantic-release": "25.0.9",
    "semver": "7.8.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
